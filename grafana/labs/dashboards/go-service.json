{
  "uid": "go-service-lab",
  "title": "Go service · вопросы и доказательства",
  "schemaVersion": 41,
  "version": 1,
  "timezone": "utc",
  "editable": false,
  "refresh": "30s",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "tags": [
    "handbook",
    "go"
  ],
  "panels": [
    {
      "id": 1,
      "title": "Завершённые запросы / s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-local"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-local"
          },
          "expr": "sum by (instance) (rate(lab_requests_total{job=\"go-lab\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 2,
      "title": "Ошибки 5xx: доля, не проценты",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-local"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-local"
          },
          "expr": "sum by (instance) (rate(lab_requests_total{job=\"go-lab\",instance=~\"${instance:regex}\",code=~\"5..\"}[$__rate_interval])) / sum by (instance) (rate(lab_requests_total{job=\"go-lab\",instance=~\"${instance:regex}\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
            "showPoints": "always",
            "pointSize": 4
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "single"
        }
      }
    },
    {
      "id": 3,
      "title": "p90 длительности: оценка histogram, s",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "prom-local"
      },
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prom-local"
          },
          "expr": "histogram_quantile(0.90, sum by (le, instance) (rate(lab_request_duration_seconds_bucket{job=\"go-lab\",instance=~\"${instance:regex}\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": true,
          "instant": false,
          "format": "time_series",
          "editorMode": "code",
          "interval": "15s"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "decimals": 2,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "linear",
            "spanNulls": false,
